        comp_grid.addWidget(ruse_lbl, 0, 0)
        comp_grid.addWidget(self.ruse_spin, 0, 1)
        
        # Опытность
        exp_lbl = QLabel("Опытность команды:")
        exp_lbl.setStyleSheet("font-weight: 500;")
