    def connect_signals(self):
        # Автообновление суммы SF
        for combo in self.sf_combos.values():
            combo.currentIndexChanged.connect(self.update_sf_total)
        
        self.arch_btn.clicked.connect(self.calculate_architecture)
        self.comp_btn.clicked.connect(self.calculate_composition)
        
        self.update_sf_total()
        
    def update_sf_total(self):
        total = 0
        for key, combo in self.sf_combos.items():
            idx = combo.currentIndex()
            total += self.SF_VALUES[key][idx]
        self.sf_total_val.setText(f"{total:.2f}")
        
    def get_sf_sum(self):
        total = 0
        for key, combo in self.sf_combos.items():
            total += self.SF_VALUES[key][combo.currentIndex()]
        return total
        
    def get_em_product(self):
        product = 1.0
        for key, combo in self.em_combos.items():
            idx = combo.currentIndex()
            values = [v for v in self.EM_VALUES[key] if v is not None]
            product *= values[idx]
        return product
        
    def calculate_architecture(self):
        # COCOMO II Early Design
        size = self.size_spin.value()  # KSLOC
        sf_sum = self.get_sf_sum()
        em_product = self.get_em_product()
        
        E = 0.91 + 0.01 * sf_sum
        pm = 2.94 * (size ** E) * em_product
        
        # Время разработки (в месяцах)
        # TDEV = 3.67 * PM^(0.28 + 0.2*(E-0.91))
        tdev = 3.67 * (pm ** (0.28 + 0.2 * (E - 0.91)))
        
        # Средняя численность
        team = pm / tdev if tdev > 0 else 0
        
        # Бюджет
        cost = self.cost_spin.value()
        budget = pm * cost
        
        # Анимация
        self.animate_button(self.arch_btn)
        
        # Вывод
        self.arch_work.set_value(pm, 1)
        self.arch_time.set_value(tdev, 1)
        self.arch_team.set_value(team, 1)
        self.arch_budget.set_value(budget, 0)
        
    def calculate_composition(self):
        # Application Composition Model
        # Object Points
        screen_op = (self.screen_spins[0].value() * 1 + 
                     self.screen_spins[1].value() * 2 + 
                     self.screen_spins[2].value() * 3)
        
        report_op = (self.report_spins[0].value() * 2 + 
                     self.report_spins[1].value() * 5 + 
                     self.report_spins[2].value() * 8)
        
        mod_op = self.mod_spin.value() * 10
        
        total_op = screen_op + report_op + mod_op
        
        # NOP с учётом повторного использования
        ruse = self.ruse_spin.value()
        nop = total_op * (100 - ruse) / 100.0
        
        # Productivity
        prod = self.PROD_VALUES[self.exp_combo.currentIndex()]
        
        # PM
        pm = nop / prod if prod > 0 else 0
        
        # Для композиции E обычно ≈ 1.0
        # TDEV = 3.0 * PM^(0.33 + 0.2*(1.01-1.01)) ≈ 3 * PM^0.33
        tdev = 3.0 * (pm ** 0.33) if pm > 0 else 0
        
        team = pm / tdev if tdev > 0 else 0
        
        cost = self.cost_spin.value()
        budget = pm * cost
        
        self.animate_button(self.comp_btn)
        
        self.comp_work.set_value(pm, 1)
        self.comp_time.set_value(tdev, 1)
        self.comp_team.set_value(team, 1)
        self.comp_budget.set_value(budget, 0)
        
    def animate_button(self, btn):
        anim = QPropertyAnimation(btn, b"geometry")
        anim.setDuration(150)
        anim.setEasingCurve(QEasingCurve.InOutQuad)
        rect = btn.geometry()
        anim.setStartValue(rect.adjusted(-3, 0, 3, 0))
        anim.setEndValue(rect)
        anim.start()


if __name__ == "__main__":
    app = QApplication(sys.argv)
    font = QFont("Segoe UI", 10)
    font.setStyleHint(QFont.SansSerif)
    app.setFont(font)
    
    dlg = CocomoDialog()
    dlg.show()
    sys.exit(app.exec_())