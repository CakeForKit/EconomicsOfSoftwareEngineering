import sys
from PyQt5.QtWidgets import (
    QApplication, QDialog, QWidget, QVBoxLayout, QHBoxLayout,
    QGridLayout, QGroupBox, QLabel, QSpinBox, QComboBox, QPushButton,
    QScrollArea, QFrame, QSizePolicy, QDoubleSpinBox, QLineEdit
)
from PyQt5.QtCore import Qt, QPropertyAnimation, QEasingCurve
from PyQt5.QtGui import QFont


class ModernCard(QFrame):
    """Карточка с тенью и скруглением"""
    def __init__(self, title="", parent=None):
        super().__init__(parent)
        self.setObjectName("card")
        self.setFrameShape(QFrame.StyledPanel)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        
        self.layout = QVBoxLayout(self)
        self.layout.setContentsMargins(24, 24, 24, 24)
        self.layout.setSpacing(16)
        
        if title:
            self.title = QLabel(title)
            self.title.setObjectName("cardTitle")
            self.title.setFont(QFont("Segoe UI", 14, QFont.Bold))
            self.layout.addWidget(self.title)


class ResultBlock(QFrame):
    """Цветной блок результата"""
    def __init__(self, title, unit, color_scheme="blue", parent=None):
        super().__init__(parent)
        self.setObjectName("resultBlock")
        
        colors = {
            "blue": ("#ebf8ff", "#2b6cb0", "#90cdf4"),
            "green": ("#f0fff4", "#22543d", "#9ae6b4"),
            "orange": ("#fffaf0", "#744210", "#fbd38d"),
            "purple": ("#faf5ff", "#553c9a", "#d6bcfa")
        }
        bg, fg, border = colors.get(color_scheme, colors["blue"])
        
        self.setStyleSheet(f"""
            ResultBlock {{
                background-color: {bg};
                border-radius: 12px;
                border: 2px solid {border};
                padding: 16px;
            }}
        """)
        
        layout = QVBoxLayout(self)
        layout.setSpacing(8)
        
        self.value_lbl = QLabel("—")
        self.value_lbl.setAlignment(Qt.AlignCenter)
        self.value_lbl.setStyleSheet(f"""
            color: {fg};
            font-size: 26px;
            font-weight: bold;
            font-family: 'Segoe UI', sans-serif;
        """)
        
        title_lbl = QLabel(title)
        title_lbl.setAlignment(Qt.AlignCenter)
        title_lbl.setStyleSheet(f"color: {fg}; font-size: 11px; font-weight: 600;")
        
        unit_lbl = QLabel(unit)
        unit_lbl.setAlignment(Qt.AlignCenter)
        unit_lbl.setStyleSheet(f"color: {fg}; font-size: 10px; opacity: 0.8;")
        
        layout.addWidget(title_lbl)
        layout.addWidget(self.value_lbl)
        layout.addWidget(unit_lbl)
        
    def set_value(self, value, decimals=1):
        if isinstance(value, float):
            self.value_lbl.setText(f"{value:,.{decimals}f}".replace(",", " "))
        else:
            self.value_lbl.setText(f"{value:,}".replace(",", " "))


class CocomoDialog(QDialog):
    # Данные COCOMO II
    SF_LEVELS = ["Очень низкий", "Низкий", "Номинальный", "Высокий", "Очень высокий", "Критический"]
