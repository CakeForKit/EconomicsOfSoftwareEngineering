        "PERS": [2.12, 1.62, 1.00, 0.83, 0.63, 0.50],
        "FCIL": [1.43, 1.30, 1.00, 0.87, 0.73, 0.62],
        "SCED": [1.43, 1.14, 1.00, 1.00, 1.00, None]
    }
    
    EXP_LEVELS = ["Очень низкий", "Низкий", "Номинальный", "Высокий", "Очень высокий"]
    PROD_VALUES = [4, 7, 13, 25, 50]  # Object Points per month
    
