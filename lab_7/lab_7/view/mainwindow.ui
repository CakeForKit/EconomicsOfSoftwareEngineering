import sys
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QGridLayout, QGroupBox, QLabel, QSpinBox, QComboBox, QPushButton,
    QScrollArea, QFrame, QSizePolicy, QSpacerItem, QHeaderView,
    QTableWidget, QTableWidgetItem, QProgressBar, QStackedWidget
)
from PyQt5.QtCore import Qt, QPropertyAnimation, QEasingCurve, pyqtSignal, QTimer
from PyQt5.QtGui import QColor, QPalette, QFont, QIcon, QLinearGradient, QBrush


class ModernCard(QFrame):
    """Карточка с тенью и скруглением"""
    def __init__(self, title="", parent=None):
        super().__init__(parent)
        self.setObjectName("card")
        self.setFrameShape(QFrame.StyledPanel)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        
        self.layout = QVBoxLayout(self)
        self.layout.setContentsMargins(20, 20, 20, 20)
        self.layout.setSpacing(15)
        
        if title:
            self.title = QLabel(title)
            self.title.setObjectName("cardTitle")
            self.title.setFont(QFont("Segoe UI", 14, QFont.Bold))
            self.layout.addWidget(self.title)


class AnimatedButton(QPushButton):
    """Кнопка с hover-эффектом"""
    def __init__(self, text, parent=None):
        super().__init__(text, parent)
        self.setObjectName("actionButton")
        self.setMinimumHeight(48)
        self.setCursor(Qt.PointingHandCursor)
        self.setFont(QFont("Segoe UI", 12, QFont.Bold))


class FunctionPointCalculator(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Калькулятор функциональных точек")
        self.setMinimumSize(1300, 900)
        
        # Центральный виджет
        self.central = QWidget()
        self.setCentralWidget(self.central)
        self.main_layout = QVBoxLayout(self.central)
        self.main_layout.setContentsMargins(30, 30, 30, 30)
        self.main_layout.setSpacing(25)
        
        self.setup_styles()
        self.setup_ui()
        self.connect_signals()
        
    def setup_styles(self):
        self.setStyleSheet("""
            QMainWindow {
                background-color: #f0f2f5;
            }
            
            /* Карточки */
            #card {
                background-color: white;
                border-radius: 12px;
                border: 1px solid #e1e4e8;
            }
            #cardTitle {
                color: #1a1a2e;
                margin-bottom: 10px;
            }
            
            /* Заголовки секций */
            QLabel#sectionHeader {
                color: #1a1a2e;
                font-size: 18px;
                font-weight: bold;
                padding: 10px 0;
            }
            
            /* Обычные метки */
            QLabel {
                color: #2d3748;
                font-size: 13px;
                font-family: 'Segoe UI', sans-serif;
            }
            
            /* Заголовки таблицы */
            QLabel#tableHeader {
                background-color: #4a5568;
                color: white;
                font-weight: bold;
                padding: 10px;
                border-radius: 6px;
                font-size: 12px;
            }
            
            /* Подзаголовки сложности */
            QLabel#complexityHeader {
                background-color: #edf2f7;
                color: #2d3748;
                font-weight: bold;
                padding: 8px;
                border-radius: 6px;
                font-size: 12px;
                text-align: center;
            }
            
            /* SpinBox */
            QSpinBox {
                background-color: #f7fafc;
                border: 2px solid #e2e8f0;
                border-radius: 8px;
                padding: 8px;
                font-size: 14px;
                min-height: 20px;
                color: #2d3748;
            }
            QSpinBox:focus {
                border-color: #4299e1;
                background-color: white;
            }
            QSpinBox::up-button, QSpinBox::down-button {
                width: 20px;
                background: #e2e8f0;
                border-radius: 4px;
                margin: 2px;
            }
            QSpinBox::up-button:hover, QSpinBox::down-button:hover {
                background: #cbd5e0;
            }
            
            /* ComboBox */
            QComboBox {
                background-color: #f7fafc;
                border: 2px solid #e2e8f0;
                border-radius: 8px;
                padding: 8px;
                font-size: 13px;
                min-height: 20px;
            }
            QComboBox:focus {
                border-color: #4299e1;
            }
            QComboBox::drop-down {
                border: none;
                width: 30px;
            }
            QComboBox QAbstractItemView {
                background-color: white;
                border: 1px solid #e2e8f0;
                selection-background-color: #4299e1;
                selection-color: white;
            }
            
            /* Результаты */
            QLabel#resultValue {
                background-color: #ebf8ff;
                color: #2b6cb0;
                font-weight: bold;
                padding: 10px;
                border-radius: 8px;
                font-size: 14px;
                border: 2px solid #bee3f8;
                min-width: 60px;
                text-align: center;
            }
            QLabel#totalValue {
                background-color: #c6f6d5;
                color: #22543d;
                font-weight: bold;
                padding: 12px;
                border-radius: 8px;
                font-size: 16px;
                border: 2px solid #9ae6b4;
            }
            
            /* Кнопка */
            #actionButton {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                    stop:0 #4299e1, stop:1 #3182ce);
                color: white;
                border: none;
                border-radius: 10px;
                font-size: 14px;
                font-weight: bold;
                padding: 12px 30px;
            }
            #actionButton:hover {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                    stop:0 #3182ce, stop:1 #2b6cb0);
            }
            #actionButton:pressed {
                background: #2c5282;
            }
            
            /* ScrollArea */
            QScrollArea {
                border: none;
                background-color: transparent;
            }
            
            /* GroupBox */
            QGroupBox {
                background-color: white;
                border-radius: 12px;
                border: 1px solid #e1e4e8;
